# Copy to .env and fill in. .env is gitignored.

# OAuth client of type "Desktop app" from the same Google Cloud project as
# Firebase. Required only for real Google sign-in; the auth emulator needs none.
LEARNTHINGS_GOOGLE_CLIENT_ID=
LEARNTHINGS_GOOGLE_CLIENT_SECRET=

# Backend proxy in front of CouchDB (not CouchDB itself).
# LEARNTHINGS_COUCH_HOST=http://localhost:3000
# LEARNTHINGS_USE_AUTH_EMULATOR=true
